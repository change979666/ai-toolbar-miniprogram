<!-- profile.wxml -->
<!-- 
  个人中心页面
  包含用户信息展示和各种设置选项
-->

<!-- 自定义导航栏组件 -->
<navigation-bar title="" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<!-- 页面主体滚动区域 -->
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 顶部标题区域：展示应用名称和简介 -->
    <view class="page-header">
      <view class="title-wrapper">
        <text class="page-title">AI灵感工具栏</text>
        <text class="page-subtitle">让AI激发你的创意灵感</text>
      </view>
    </view>

    <!-- 用户信息卡片：展示头像、昵称和简介 -->
    <view class="user-card">
      <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatarUrl || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
      </button>
      <view class="user-info">
        <input type="nickname" class="nickname-input" placeholder="请输入昵称" bind:input="onInputNickname" value="{{nickName}}"/>
        <view class="user-desc">点击头像和昵称可修改</view>
      </view>
    </view>

    <!-- 设置列表区域：包含多个设置板块 -->
    <view class="settings-list">
      <!-- 账号与安全板块：手机号绑定 -->
      <view class="settings-section">
        <view class="section-header">
          <text class="section-title">账号与安全</text>
        </view>
        <view class="section-content">
          <!-- 手机号设置项 -->
          <view class="settings-item">
            <view class="item-icon">📱</view>
            <view class="item-info">
              <text class="item-title">手机号</text>
              <text class="item-desc">{{userInfo.phoneNumber || '未绑定'}}</text>
            </view>
            <button class="get-phone-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber" 
                    wx:if="{{!userInfo.phoneNumber}}">绑定手机号</button>
            <text class="item-arrow" wx:else>></text>
          </view>
        </view>
      </view>

      <!-- 通用设置板块（原"其他"版块）：客服、关于和协议 -->
      <view class="settings-section">
        <view class="section-header">
          <text class="section-title">通用设置</text>
        </view>
        <view class="section-content">
          <!-- 联系客服 -->
          <view class="settings-item" bindtap="onContactService">
            <view class="item-icon">📞</view>
            <view class="item-info">
              <text class="item-title">联系客服</text>
              <text class="item-desc">获取帮助与支持</text>
            </view>
            <text class="item-arrow">></text>
          </view>
          <!-- 关于我们 -->
          <view class="settings-item" bindtap="handleAboutTap">
            <view class="item-icon">ℹ️</view>
            <view class="item-info">
              <text class="item-title">关于我们</text>
              <text class="item-desc">了解应用信息</text>
            </view>
            <text class="item-arrow">></text>
          </view>
          <!-- 用户协议 -->
          <view class="settings-item" bindtap="onUserAgreement">
            <view class="item-icon">📜</view>
            <view class="item-info">
              <text class="item-title">用户协议</text>
              <text class="item-desc">了解服务条款</text>
            </view>
            <text class="item-arrow">></text>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view> 