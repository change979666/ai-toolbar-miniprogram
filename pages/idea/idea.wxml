<!-- 创意激发页面 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="handleBack">
      <text class="back-icon">‹</text>
      <text class="back-text">返回</text>
    </view>
    <text class="title">创意激发</text>
  </view>

  <!-- 创意激发内容区域 -->
  <view class="idea-content">
    <view class="idea-container">
      <view class="input-area">
        <textarea placeholder="请输入你的创意需求或问题" bindinput="onInput" value="{{prompt}}"></textarea>
        <button bindtap="generateIdea">生成创意</button>
      </view>
      <view class="result-area">
        <text wx:if="{{ideaText}}">{{ideaText}}</text>
        <view wx:else class="placeholder">创意内容将在这里显示</view>
      </view>
    </view>
  </view>
</view> 