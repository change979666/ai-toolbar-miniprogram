<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="handleBack">
      <text class="back-icon">‹</text>
      <text class="back-text">返回</text>
    </view>
    <text class="title">文案创作</text>
  </view>

  <!-- 文案创作内容区域 -->
  <view class="copy-content">
    <view class="copy-container">
      <view class="input-area">
        <textarea placeholder="请输入文案需求" bindinput="onInput" value="{{prompt}}"></textarea>
        <button bindtap="generateCopy">生成文案</button>
      </view>
      <view class="result-area">
        <text wx:if="{{copyText}}">{{copyText}}</text>
        <view wx:else class="placeholder">文案将在这里显示</view>
      </view>
    </view>
  </view>
</view> 