.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.copy-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20px;
}

.input-area {
  margin-bottom: 20px;
}

.input-area textarea {
  width: 100%;
  height: 100px;
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 10px;
  margin-bottom: 10px;
}

.input-area button {
  width: 100%;
  height: 40px;
  background-color: #07c160;
  color: #fff;
  border: none;
  border-radius: 4px;
}

.result-area {
  flex: 1;
  padding: 20px;
  background-color: #f5f5f5;
  border-radius: 4px;
  overflow-y: auto;
}

.result-area text {
  white-space: pre-wrap;
  word-break: break-all;
}

.placeholder {
  color: #999;
  font-size: 14px;
  text-align: center;
}

/* 导航栏样式 */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 10rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
  margin-right: 10rpx;
}

.back-text {
  font-size: 28rpx;
  color: #333;
}

.nav-bar .title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
} 