/* 页面容器 */
.container {
  padding: 0;
  background: #f7f8fa;
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 40px; /* 为底部按钮留出空间 */
  position: relative;
}

/* 协议内容区域 */
.agreement-content {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  margin: 0 20px;
  margin-top: 20px;
}

/* 区块标题 */
.section-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  padding: 12px 20px;
  border-bottom: 1px solid #f0f0f0;
  text-align: center;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 1;
}

/* 区块内容 */
.section-content {
  padding: 20px;
  width: 100%;
  box-sizing: border-box;
}

/* 协议文本 */
.agreement-text {
  font-size: 14px;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  width: 100%;
  box-sizing: border-box;
}

/* 底部返回按钮 */
.bottom-back {
  position: absolute;
  bottom: 5%;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  z-index: 100;
}

.back-button {
  width: 10%;
  min-width: 80px;
  max-width: 120px;
  height: 44px;
  background-color: #1296db;
  color: #fff;
  border: none;
  border-radius: 22px;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.back-button:active {
  background-color: #0d7eb8;
  transform: scale(0.98);
}

/* 导航栏固定定位 */
.nav-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

/* 滚动区域 */
.agreement-scroll {
  height: 100vh;
  padding-top: 44px;
  padding-bottom: 100px;
  box-sizing: border-box;
}

/* 容器样式 */
.agreement-container {
  padding: 20px;
}

/* 内容区域 */
.agreement-content {
  background-color: #fff;
  border-radius: 8px;
  padding: 20px;
}

/* 标题样式 */
.agreement-title {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 20px;
  text-align: center;
}

.agreement-text {
  font-size: 16px;
  line-height: 1.6;
  margin-bottom: 20px;
}

/* 章节标题 */
.section-title {
  font-size: 18px;
  font-weight: bold;
  margin: 20px 0 10px;
  color: #333;
}

/* 章节内容 */
.section-text {
  font-size: 16px;
  line-height: 1.6;
  color: #666;
  margin-bottom: 15px;
}

/* 用户协议页面样式 */
.agreement-container {
  position: relative;
  height: 100vh;
  background-color: #ffffff;
  padding: 0;
  box-sizing: border-box;
  padding-top: 88rpx; /* 为导航栏留出空间 */
}

/* 协议内容区域 */
.agreement-content {
  height: calc(100vh - 200rpx);
  padding: 20rpx;
  box-sizing: border-box;
}

.agreement-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  padding: 20rpx;
}

.agreement-text .title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
  display: block;
}

.agreement-text text {
  display: block;
  margin-bottom: 20rpx;
}

/* 底部返回按钮 */
.bottom-back {
  position: fixed;
  bottom: 5%;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  padding: 20rpx;
  z-index: 10;
}

.back-button {
  width: 10%;
  min-width: 80px;
  max-width: 120px;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #007AFF;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.back-button:active {
  transform: scale(0.98);
  opacity: 0.9;
} 